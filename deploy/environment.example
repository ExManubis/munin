# munin's settings on the server, read by both services. install.sh writes /etc/munin/environment
# from this the first time, with this machine's tailnet name and your Tailscale login filled in;
# after that it's yours to change (then: sudo systemctl restart munin-tracker munin-runtime).
# Keys go in /etc/munin/secrets instead, which only the runtime reads.

# Where people reach munin, through tailscale serve, and who may.
MUNIN_PUBLIC_URL=@PUBLIC_URL@
MUNIN_USERS=@USERS@
# The name your comments and answers get.
MUNIN_USER=me

# Where munin keeps things.
MUNIN_DB=/var/lib/munin/munin.db
MUNIN_RUNTIME_DB=/var/lib/munin/runtime.sqlite
MUNIN_AGENTS_DIR=/var/lib/munin/agents
MUNIN_REPOS_DIR=/var/lib/munin/repos

# Both services listen on this machine only; tailscale serve is the way in.
MUNIN_PORT=7777
MUNIN_RUNTIME_PORT=7779
# Agents' tracker calls stay on this machine.
MUNIN_TRACKER_MCP=http://127.0.0.1:7777/mcp

# Each coder in a container of its own. Use an image with your projects' tools in it.
MUNIN_AGENT_SANDBOX=docker
MUNIN_AGENT_IMAGE=buildpack-deps:bookworm-scm
# Each coder's container sits behind a firewall that blocks this machine and the tailnet, where
# munin listens, but not the internet. "none" takes the internet away too.
# MUNIN_AGENT_NETWORK=none

# Variables from /etc/munin/secrets that agents' shells get, like a token to push with.
# MUNIN_AGENT_ENV=GH_TOKEN

# An Ollama server for models, if you have one.
# MUNIN_OLLAMA_URL=http://127.0.0.1:11434
