# munin's settings on this Mac, read by the tracker. install-mac.sh writes ~/.munin/environment
# from this the first time, with this Mac's tailnet name and your Tailscale login filled in; after
# that it's yours to change (then run install-mac.sh again, or restart it:
# launchctl kickstart -k gui/$(id -u)/munin.tracker).

# Where people reach munin, through tailscale serve, and who may.
MUNIN_PUBLIC_URL=@PUBLIC_URL@
MUNIN_USERS=@USERS@
# The name your comments and answers get.
MUNIN_USER=me

# Where munin keeps things.
MUNIN_DB=@HOME@/.munin/munin.db

# munin listens on this Mac only; tailscale serve is the way in.
MUNIN_PORT=7777
