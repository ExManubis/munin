# munin's settings on this Mac, read by both services. install-mac.sh writes ~/.munin/environment
# from this the first time, with this Mac's tailnet name and your Tailscale login filled in; after
# that it's yours to change (then run install-mac.sh again, or restart the services:
# launchctl kickstart -k gui/$(id -u)/munin.tracker, and munin.runtime).
# Keys go in ~/.munin/secrets instead, which only the runtime reads.

# Where people reach munin, through tailscale serve, and who may.
MUNIN_PUBLIC_URL=@PUBLIC_URL@
MUNIN_USERS=@USERS@
# The name your comments and answers get.
MUNIN_USER=me

# Where munin keeps things. Docker Desktop shares /Users with containers, which coders need.
MUNIN_DB=@HOME@/.munin/munin.db
MUNIN_RUNTIME_DB=@HOME@/.munin/runtime.sqlite
MUNIN_AGENTS_DIR=@HOME@/.munin/agents
MUNIN_REPOS_DIR=@HOME@/.munin/repos

# Both services listen on this Mac only; tailscale serve is the way in.
MUNIN_PORT=7777
MUNIN_RUNTIME_PORT=7779
# Agents' tracker calls stay on this Mac.
MUNIN_TRACKER_MCP=http://127.0.0.1:7777/mcp

# Each coder in a container of its own. Use an image with your projects' tools in it.
MUNIN_AGENT_SANDBOX=docker
MUNIN_AGENT_IMAGE=buildpack-deps:bookworm-scm
# Docker Desktop and OrbStack let containers reach this Mac's 127.0.0.1 through host.docker.internal,
# so a coder could reach munin's own web API. "none" closes that, and the internet with it.
# MUNIN_AGENT_NETWORK=none

# Variables from ~/.munin/secrets that agents' shells get, like a token to push with.
# MUNIN_AGENT_ENV=GH_TOKEN

# An Ollama server for models, if you have one.
# MUNIN_OLLAMA_URL=http://127.0.0.1:11434
