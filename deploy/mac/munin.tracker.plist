<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- munin's tracker, as a launchd agent of yours: issues, the inbox, MCP for agents and the web UI.
     It reads ~/.munin/environment at each start and listens on this Mac only. Installed by
     deploy/install-mac.sh, which fills in where things are. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>munin.tracker</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>set -a; . "@HOME@/.munin/environment"; set +a; exec "@MUNIN_DIR@/tracker/.venv/bin/munin" serve</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>@PATH@</string>
  </dict>
  <key>WorkingDirectory</key>
  <string>@HOME@/.munin</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>5</integer>
  <key>StandardOutPath</key>
  <string>@HOME@/.munin/logs/tracker.log</string>
  <key>StandardErrorPath</key>
  <string>@HOME@/.munin/logs/tracker.log</string>
</dict>
</plist>
